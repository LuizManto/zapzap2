                      AND m2.id_remetente != 2
                      AND m2.apagada_em IS NULL
                ) AS nao_lidas
            FROM conversas_usuarios cu
            INNER JOIN conversas c ON c.id_conversa = cu.id_conversa
            LEFT JOIN conversas_usuarios outro_cu
