                CASE WHEN c.tipo = \'individual\' THEN outro.avatar ELSE c.foto   END AS foto_exibida,
                CASE WHEN ultima.apagada_em IS NOT NULL THEN \'Mensagem apagada\' ELSE ultima.corpo END AS ultima_mensagem,
