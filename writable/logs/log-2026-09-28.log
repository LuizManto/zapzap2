                   ON ultima.id_mensagem = (SELECT MAX(id_mensagem) FROM mensagens WHERE id_conversa = c.id_conversa)
            WHERE cu.id_usuario = 2
            ORDER BY ultima.criado_em DESC, c.criado_em DESC
        ')
